<svg
  class="bagang-svg"
  viewBox="0 0 640 490"
  role="img"
  aria-labelledby="bagang-title bagang-desc"
>
  <title id="bagang-title">八纲四对坐标示意</title>
  <desc id="bagang-desc">
    阴阳居中为总纲；表与里、寒与热、虚与实三对坐标环绕四周。表里定病位深浅，寒热定病性，虚实定正邪盛衰。
  </desc>

  <circle class="bg-ring" cx="320" cy="245" r="205" />
  <circle class="bg-ring bg-ring--inner" cx="320" cy="245" r="128" />

  <line class="bg-axis" x1="130" y1="245" x2="510" y2="245" />
  <line class="bg-axis" x1="228" y1="82" x2="412" y2="408" />
  <line class="bg-axis" x1="412" y1="82" x2="228" y2="408" />

  <g class="bg-node bg-node--yang">
    <circle cx="130" cy="245" r="38" />
    <text class="bg-title" x="130" y="255">表</text>
    <text class="bg-note" x="130" y="308">病位 · 浅</text>
  </g>

  <g class="bg-node bg-node--yin">
    <circle cx="510" cy="245" r="38" />
    <text class="bg-title" x="510" y="255">里</text>
    <text class="bg-note" x="510" y="308">病位 · 深</text>
  </g>

  <g class="bg-node bg-node--yang">
    <circle cx="412" cy="82" r="38" />
    <text class="bg-title" x="412" y="92">热</text>
    <text class="bg-note" x="412" y="145">病性 · 热</text>
  </g>

  <g class="bg-node bg-node--yin">
    <circle cx="228" cy="408" r="38" />
    <text class="bg-title" x="228" y="418">寒</text>
    <text class="bg-note" x="228" y="471">病性 · 寒</text>
  </g>

  <g class="bg-node bg-node--yin">
    <circle cx="228" cy="82" r="38" />
    <text class="bg-title" x="228" y="92">虚</text>
    <text class="bg-note" x="228" y="145">正邪 · 不足</text>
  </g>

  <g class="bg-node bg-node--yang">
    <circle cx="412" cy="408" r="38" />
    <text class="bg-title" x="412" y="418">实</text>
    <text class="bg-note" x="412" y="471">正邪 · 有余</text>
  </g>

  <g class="bg-center">
    <circle cx="320" cy="245" r="64" />
    <text class="bg-center-title" x="320" y="241">阴阳</text>
    <text class="bg-center-note" x="320" y="264">总纲</text>
  </g>
</svg>
