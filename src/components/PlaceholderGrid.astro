---
interface PlaceholderItem {
  title: string;
  description: string;
  meta?: string;
}

interface Props {
  items: PlaceholderItem[];
  columns?: 3 | 4 | 5;
}

const { items, columns } = Astro.props;
---

<div class:list={['placeholder-grid', columns && `placeholder-grid--${columns}`]}>
  {items.map((item, index) => (
    <article class="placeholder-card">
      <div class="placeholder-top">
        <span class="placeholder-index">{String(index + 1).padStart(2, '0')}</span>
        <span class="placeholder-meta">{item.meta ?? '待接入'}</span>
      </div>
      <h2 class="placeholder-title">{item.title}</h2>
      <p class="placeholder-text">{item.description}</p>
      <div class="skeleton-line skeleton-line--short" aria-hidden="true"></div>
    </article>
  ))}
</div>
