---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="这个页面还没有建好。">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1 class="page-title">这一页还在纸外</h1>
      <p class="page-lead">地址可能写错了，或者页面还没有开始建。</p>
      <div class="hero-actions">
        <a class="btn btn--primary" href="/">回到五术总览</a>
      </div>
    </div>
  </section>
</BaseLayout>
