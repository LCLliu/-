---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { disciplines, type Discipline } from '../../data/disciplines';

export function getStaticPaths() {
  return disciplines.map((discipline) => ({
    params: { discipline: discipline.slug },
    props: { discipline },
  }));
}

interface Props {
  discipline: Discipline;
}

const { discipline } = Astro.props;
const isYi = discipline.slug === 'yi';
---

<BaseLayout
  title={`${discipline.name}｜${discipline.tagline}`}
  description={discipline.summary}
>
  <section class={`discipline-hero discipline-hero--${discipline.slug}`}>
    <div class="discipline-watermark" aria-hidden="true">{discipline.name}</div>

    <div class="container discipline-hero-inner">
      <div>
        <nav class="breadcrumb" aria-label="面包屑">
          <a href="/">五术总览</a>
          <span>/</span>
          <span aria-current="page">{discipline.name}</span>
        </nav>

        <div class="discipline-title-row">
          <h1 class="discipline-name">{discipline.name}</h1>
          <div class="discipline-meta">
            <span class="discipline-pinyin">{discipline.pinyin}</span>
            <span class="discipline-tagline">{discipline.tagline}</span>
          </div>
        </div>

        <p class="discipline-summary">{discipline.summary}</p>
        <p class="discipline-focus">{discipline.focus}</p>
      </div>

      <div class="discipline-side">
        <span class="discipline-side-label">当前状态</span>
        <StatusBadge status={discipline.status} />
        <p>
          {isYi ? '藏象到气血津液、四诊与辨证初稿已开放' : '界面骨架已建立'}
          <br />
          {isYi ? '方药与经典选读待补' : '知识内容尚未接入'}
        </p>
      </div>
    </div>
  </section>

  <section class="discipline-body container">
    <div class="panel">
      <div class="panel-head">
        <div>
          <p class="panel-kicker">页面模板</p>
          <h2 class="panel-title">
            {isYi ? '首期建设：医的纵向切片' : '等待模板复制'}
          </h2>
          <p class="panel-lede">
            {isYi
              ? '藏象、经络、气血津液、四诊与辨证初稿已开放；方药与经典选读待补。'
              : '医的门类模板稳定后，这一门会按同样的页面结构接入，避免五套不同的实现。'}
          </p>
        </div>
        <StatusBadge status={isYi ? '首期建设' : '规划中'} />
      </div>

      <div class="callout">
        <p class="callout-title">首期边界</p>
        <p>
          {isYi
            ? '只做传统理论、历史与文献展示，不提供诊断、处方或疗效建议。'
            : '当前只保留结构占位，不提前编写缺乏来源核对的内容。'}
        </p>
      </div>

      {isYi && (
        <>
          <a class="opened-card" href="/yi/zangxiang/">
            <span>
              <strong>藏象 · 初稿</strong>
              <small>五脏、六腑、奇恒之府与外在征象</small>
            </span>
            <span>开始阅读 →</span>
          </a>
          <a class="opened-card" href="/yi/jingluo/">
            <span>
              <strong>十二经络 · 初稿</strong>
              <small>十二正经、表里、走向与流注</small>
            </span>
            <span>开始阅读 →</span>
          </a>
          <a class="opened-card" href="/yi/qijing/">
            <span>
              <strong>奇经八脉 · 初稿</strong>
              <small>任督冲带、阴阳跷维与调节层</small>
            </span>
            <span>开始阅读 →</span>
          </a>
          <a class="opened-card" href="/yi/luomai/">
            <span>
              <strong>络脉 · 初稿</strong>
              <small>十五别络、络穴与表里网络</small>
            </span>
            <span>开始阅读 →</span>
          </a>
          <a class="opened-card" href="/yi/rendu-xuewei/">
            <span>
              <strong>任督穴位 · 初稿</strong>
              <small>任脉 24 穴、督脉 28 穴与前后正中线</small>
            </span>
            <span>开始阅读 →</span>
          </a>
          <a class="opened-card" href="/yi/jingxing-shu/">
            <span>
              <strong>井荥俞原经合 · 初稿</strong>
              <small>十二经五输表与单经示例</small>
            </span>
            <span>开始阅读 →</span>
          </a>
          <a class="opened-card" href="/yi/qixue-jinye/">
            <span>
              <strong>气血津液 · 初稿</strong>
              <small>同源、互根、同行</small>
            </span>
            <span>开始阅读 →</span>
          </a>
          <a class="opened-card" href="/yi/zhenfa/">
            <span>
              <strong>诊法 · 初稿</strong>
              <small>望闻问切与四诊合参</small>
            </span>
            <span>开始阅读 →</span>
          </a>
          <a class="opened-card" href="/yi/wangzhen/">
            <span>
              <strong>望诊与舌诊 · 初稿</strong>
              <small>神色形态、五色与舌面分区</small>
            </span>
            <span>开始阅读 →</span>
          </a>
          <a class="opened-card" href="/yi/sizhen-hecan/">
            <span>
              <strong>四诊合参案例 · 初稿</strong>
              <small>三个虚构案例与复盘清单</small>
            </span>
            <span>开始阅读 →</span>
          </a>
          <a class="opened-card" href="/yi/bianzheng-zhifa/">
            <span>
              <strong>辨证与治法 · 初稿</strong>
              <small>从证据到方向，不写方剂</small>
            </span>
            <span>开始阅读 →</span>
          </a>
        </>
      )}

      <div class="template-stack">
        <div class="template-layer">
          <strong>一句话结论</strong>
          <span>每页先给出可直接理解的核心判断，再展开细节。</span>
          <em>待接入</em>
        </div>
        <div class="template-layer">
          <strong>图解</strong>
          <span>用原创 SVG 或示意图解释概念关系，避免大段堆字。</span>
          <em>待接入</em>
        </div>
        <div class="template-layer">
          <strong>原文选读</strong>
          <span>原文、出处、注释与白话分层展示，标明版本。</span>
          <em>待接入</em>
        </div>
      </div>

      <div class="skeleton-board" aria-hidden="true">
        <div class="skeleton-card"><span></span><span></span><span></span></div>
        <div class="skeleton-card"><span></span><span></span><span></span></div>
        <div class="skeleton-card"><span></span><span></span><span></span></div>
      </div>
    </div>

    <aside class="side-card">
      <h2 class="side-title">本门规划</h2>
      <p class="side-note">按页面结构排列，不代表最终顺序</p>
      <ol class="side-list">
        {discipline.sections.map((section, index) => (
          <li class="side-item">
            <span class="side-num">{String(index + 1).padStart(2, '0')}</span>
            <span>{section}</span>
          </li>
        ))}
      </ol>
      <div class="side-foot">
        <a class="back-link" href="/">← 返回五术总览</a>
      </div>
    </aside>
  </section>
</BaseLayout>
